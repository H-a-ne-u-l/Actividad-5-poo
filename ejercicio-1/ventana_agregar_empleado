import tkinter as tk
from tkinter import ttk, messagebox
from enumerados import TipoCargo, TipoGenero
from empleado import Empleado
from lista_empleados import ListaEmpleados
from utilidades import centrar_ventana

class VentanaAgregarEmpleado(tk.Toplevel):
    def __init__(self, parent, lista: ListaEmpleados):
        """Constructor de la ventana modal para registrar un nuevo empleado."""
        super().__init__(parent)
        self.lista = lista
        self.title("Agregar Empleado")
        self.resizable(False, False)
        centrar_ventana(self, 300, 400)
        self.transient(parent)
        self.grab_set()
        self.inicio()

    def inicio(self):
        """Crea y posiciona todos los componentes gráficos del formulario."""
        tk.Label(self, text="Nombre:", anchor="w").place(x=20, y=20, width=135, height=23)
        self.campo_nombre = tk.Entry(self)
        self.campo_nombre.place(x=160, y=20, width=115, height=23)

        tk.Label(self, text="Apellidos:", anchor="w").place(x=20, y=50, width=135, height=23)
        self.campo_apellidos = tk.Entry(self)
        self.campo_apellidos.place(x=160, y=50, width=115, height=23)

        tk.Label(self, text="Cargo:", anchor="w").place(x=20, y=80, width=135, height=23)
        self.campo_cargo = ttk.Combobox(
            self,
            state="readonly",
            values=[c.value for c in TipoCargo]
        )
        self.campo_cargo.current(0)
        self.campo_cargo.place(x=160, y=80, width=115, height=23)

        tk.Label(self, text="Género:", anchor="w").place(x=20, y=110, width=100, height=30)
        self.grupo_genero = tk.StringVar(value=TipoGenero.MASCULINO.value)
        tk.Radiobutton(
            self, text="Masculino", variable=self.grupo_genero,
            value=TipoGenero.MASCULINO.value, anchor="w"
        ).place(x=160, y=110, width=100, height=30)
        tk.Radiobutton(
            self, text="Femenino", variable=self.grupo_genero,
            value=TipoGenero.FEMENINO.value, anchor="w"
        ).place(x=160, y=140, width=100, height=30)

        tk.Label(self, text="Salario por día:", anchor="w").place(x=20, y=170, width=135, height=23)
        self.campo_salario_dia = tk.Entry(self)
        self.campo_salario_dia.place(x=160, y=170, width=115, height=23)

        tk.Label(self, text="Días trabajados al mes:", anchor="w").place(x=20, y=200, width=135, height=23)
        self.campo_numero_dias = tk.Spinbox(self, from_=1, to=31)
        self.campo_numero_dias.delete(0, tk.END)
        self.campo_numero_dias.insert(0, "30")
        self.campo_numero_dias.place(x=160, y=200, width=50, height=23)

        tk.Label(self, text="Otros ingresos:", anchor="w").place(x=20, y=230, width=135, height=23)
        self.campo_otros_ingresos = tk.Entry(self)
        self.campo_otros_ingresos.place(x=160, y=230, width=115, height=23)

        tk.Label(self, text="Pagos por salud:", anchor="w").place(x=20, y=260, width=135, height=23)
        self.campo_aportes_salud = tk.Entry(self)
        self.campo_aportes_salud.place(x=160, y=260, width=115, height=23)

        tk.Label(self, text="Aportes pensiones:", anchor="w").place(x=20, y=290, width=135, height=23)
        self.campo_pensiones = tk.Entry(self)
        self.campo_pensiones.place(x=160, y=290, width=115, height=23)

        tk.Button(self, text="Agregar", command=self.anadir_empleado).place(x=20, y=335, width=100, height=25)
        tk.Button(self, text="Borrar", command=self.limpiar_campos).place(x=160, y=335, width=100, height=25)

        self.campo_nombre.focus_set()

    def limpiar_campos(self):
        """Restablece todos los campos del formulario a sus valores por defecto."""
        for campo in (
            self.campo_nombre, self.campo_apellidos, self.campo_salario_dia,
            self.campo_otros_ingresos, self.campo_aportes_salud, self.campo_pensiones
        ):
            campo.delete(0, tk.END)

        self.campo_cargo.current(0)
        self.grupo_genero.set(TipoGenero.MASCULINO.value)
        self.campo_numero_dias.delete(0, tk.END)
        self.campo_numero_dias.insert(0, "30")
        self.campo_nombre.focus_set()

    def anadir_empleado(self):
        """Valida los datos ingresados, instancia un Empleado y lo añade a la lista."""
        try:
            nombre = self.campo_nombre.get().strip()
            apellidos = self.campo_apellidos.get().strip()
            if not nombre or not apellidos:
                raise ValueError("El nombre y los apellidos son obligatorios.")

            tipo_c = TipoCargo(self.campo_cargo.get())
            tipo_g = TipoGenero(self.grupo_genero.get())

            salario_dia = float(self.campo_salario_dia.get())
            dias_trabajados = int(self.campo_numero_dias.get())
            otros_ingresos = float(self.campo_otros_ingresos.get())
            pagos_salud = float(self.campo_aportes_salud.get())
            aporte_pensiones = float(self.campo_pensiones.get())

            if not (1 <= dias_trabajados <= 31):
                raise ValueError("Los días trabajados deben estar entre 1 y 31.")
            if any(v < 0 for v in (salario_dia, otros_ingresos, pagos_salud, aporte_pensiones)):
                raise ValueError("Los valores monetarios no pueden ser negativos.")

            empleado = Empleado(
                nombre, apellidos, tipo_c, tipo_g,
                salario_dia, dias_trabajados, otros_ingresos,
                pagos_salud, aporte_pensiones
            )
            self.lista.agregar_empleado(empleado)

            messagebox.showinfo("Mensaje", "El empleado ha sido agregado", parent=self)
            self.limpiar_campos()
        except ValueError as e:
            messagebox.showerror(
                "Error",
                f"Campo nulo o error en formato de número.\n({e})",
                parent=self
            )
