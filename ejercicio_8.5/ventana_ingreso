import tkinter as tk
from tkinter import messagebox
from datetime import datetime
from hotel import Hotel
from huesped import Huesped
from utilidades import centrar_ventana

class VentanaIngreso(tk.Toplevel):
    def __init__(self, parent, hotel: Hotel, numero_habitacion_reservada: int):
        """Constructor de la ventana para registrar el ingreso de un huésped."""
        super().__init__(parent)
        self.hotel = hotel
        self.numero_habitacion_reservada = numero_habitacion_reservada
        self.title("Ingreso")
        self.resizable(False, False)
        centrar_ventana(self, 290, 250)
        self.transient(parent)
        self.grab_set()
        self.inicio()

    def inicio(self):
        """Organiza los componentes gráficos mediante distribución en cuadrícula (grid)."""
        contenedor = tk.Frame(self)
        contenedor.pack(expand=True, fill="both", padx=10, pady=10)
        contenedor.columnconfigure(0, weight=1)
        contenedor.columnconfigure(1, weight=1)

        tk.Label(contenedor, text=f"Habitación: {self.numero_habitacion_reservada}", anchor="w").grid(
            row=0, column=0, columnspan=2, sticky="ew", padx=3, pady=3
        )

        tk.Label(contenedor, text="Fecha (aaaa-mm-dd):", anchor="w").grid(row=1, column=0, sticky="ew", padx=3, pady=3)
        self.campo_fecha_ingreso = tk.Entry(contenedor)
        self.campo_fecha_ingreso.grid(row=1, column=1, sticky="ew", padx=3, pady=3)

        tk.Label(contenedor, text="Huésped", anchor="w", font=("TkDefaultFont", 9, "bold")).grid(
            row=2, column=0, columnspan=2, sticky="ew", padx=3, pady=3
        )

        tk.Label(contenedor, text="Nombre:", anchor="w").grid(row=3, column=0, sticky="ew", padx=3, pady=3)
        self.campo_nombre = tk.Entry(contenedor)
        self.campo_nombre.grid(row=3, column=1, sticky="ew", padx=3, pady=3)

        tk.Label(contenedor, text="Apellidos:", anchor="w").grid(row=4, column=0, sticky="ew", padx=3, pady=3)
        self.campo_apellidos = tk.Entry(contenedor)
        self.campo_apellidos.grid(row=4, column=1, sticky="ew", padx=3, pady=3)

        tk.Label(contenedor, text="Doc. Identidad:", anchor="w").grid(row=5, column=0, sticky="ew", padx=3, pady=3)
        self.campo_documento_identidad = tk.Entry(contenedor)
        self.campo_documento_identidad.grid(row=5, column=1, sticky="ew", padx=3, pady=3)

        tk.Button(contenedor, text="Aceptar", command=self.registrar_ingreso).grid(
            row=6, column=0, sticky="ew", padx=3, pady=8
        )
        tk.Button(contenedor, text="Cancelar", command=self.destroy).grid(
            row=6, column=1, sticky="ew", padx=3, pady=8
        )

        self.campo_fecha_ingreso.focus_set()

    def registrar_ingreso(self):
        """Valida los datos del huésped, asigna la habitación y actualiza su estado."""
        habitacion = self.hotel.obtener_habitacion(self.numero_habitacion_reservada)
        if habitacion is None:
            return

        try:
            fecha_ingresada = self.campo_fecha_ingreso.get().strip()
            fecha = datetime.strptime(fecha_ingresada, "%Y-%m-%d")
        except ValueError:
            messagebox.showerror("Mensaje", "La fecha no está en el formato solicitado (aaaa-mm-dd)", parent=self)
            return

        try:
            nombre_val = self.campo_nombre.get().strip()
            apellidos_val = self.campo_apellidos.get().strip()
            if not nombre_val or not apellidos_val:
                raise ValueError("Campos de texto vacíos")

            documento_val = int(self.campo_documento_identidad.get().strip())
            if documento_val <= 0:
                raise ValueError("Documento inválido")
        except ValueError:
            messagebox.showerror("Error", "Campo nulo o error en formato de número", parent=self)
            return

        huesped = Huesped(nombre_val, apellidos_val, documento_val)
        huesped.set_fecha_ingreso(fecha)
        habitacion.set_huesped(huesped)
        habitacion.set_disponible(False)

        messagebox.showinfo("Mensaje", "El huésped ha sido registrado", parent=self)
        self.destroy()
