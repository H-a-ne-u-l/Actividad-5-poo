from habitacion import Habitacion

class Hotel:
    def __init__(self):
        """Constructor que inicializa las diez habitaciones del hotel con sus tarifas."""
        self.lista_habitaciones: list[Habitacion] = [
            Habitacion(i, True, 120000.0 if i <= 5 else 160000.0)
            for i in range(1, 11)
        ]

    def obtener_habitacion(self, numero: int) -> Habitacion | None:
        """Retorna el objeto Habitacion correspondiente al número indicado."""
        if 1 <= numero <= len(self.lista_habitaciones):
            return self.lista_habitaciones[numero - 1]
        return None

    def buscar_fecha_ingreso_habitacion(self, numero: int) -> str:
        """Busca una habitación por número y retorna su fecha de ingreso formateada."""
        habitacion = self.obtener_habitacion(numero)
        if habitacion:
            huesped = habitacion.get_huesped()
            if huesped and huesped.get_fecha_ingreso():
                return huesped.get_fecha_ingreso().strftime("%Y/%m/%d")
        return ""

    def buscar_habitacion_ocupada(self, numero: int) -> bool:
        """Verifica si la habitación indicada se encuentra ocupada."""
        habitacion = self.obtener_habitacion(numero)
        return habitacion is not None and not habitacion.get_disponible()
